---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Sidereal Cog - Development Projects" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="256x256" href="/icon-256.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <header>
      <nav class="container">
        <div class="nav-content">
          <a href="/" class="logo">
            <img src="/logo.svg" alt="Sidereal Cog" class="logo-image" />
            <span>Sidereal Cog</span>
          </a>
          <div class="nav-links">
            <a href="/">Projects</a>
            <a href="/about">About</a>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Sidereal Cog. All rights reserved.</p>
      </div>
    </footer>

    <style>
      @import '../styles/global.css';

      header {
        background-color: var(--sc-white);
        border-bottom: 1px solid var(--sc-silver);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(10px);
        background-color: rgba(255, 255, 255, 0.95);
      }

      nav {
        padding: var(--sc-space-lg) var(--sc-space-lg);
      }

      .nav-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: var(--sc-space-sm);
        font-size: var(--sc-text-xl);
        font-weight: 600;
        color: var(--sc-navy);
      }

      .logo-image {
        height: 32px;
        width: auto;
      }

      .nav-links {
        display: flex;
        gap: var(--sc-space-xl);
      }

      .nav-links a {
        color: var(--sc-text-secondary);
        font-weight: 500;
        transition: color 0.2s ease;
      }

      .nav-links a:hover {
        color: var(--sc-blue);
        opacity: 1;
      }

      main {
        min-height: calc(100vh - 200px);
      }

      footer {
        background-color: var(--sc-navy);
        color: var(--sc-silver);
        padding: var(--sc-space-2xl) 0;
      }

      footer p {
        text-align: center;
        color: var(--sc-silver);
        margin: 0;
      }

      @media (max-width: 768px) {
        .nav-content {
          flex-direction: column;
          gap: var(--sc-space-md);
        }

        .nav-links {
          gap: var(--sc-space-lg);
        }
      }
    </style>
  </body>
</html>
